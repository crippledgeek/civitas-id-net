<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IL3058: shared-framework Http.Abstractions.dll lacks [IsAotCompatible] metadata
         but is verified trim-safe (see memory: aspnetcore-http-abstractions-aot). -->
    <NoWarn>$(NoWarn);IL3058</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Civitas.Id.Sweden\Civitas.Id.Sweden.csproj" />
    <ProjectReference Include="..\..\Civitas.Id.Sweden.Json\Civitas.Id.Sweden.Json.csproj" />
    <ProjectReference Include="..\..\Civitas.Id.Sweden.DataAnnotations\Civitas.Id.Sweden.DataAnnotations.csproj" />
    <ProjectReference Include="..\..\Civitas.Id.Sweden.AspNetCore\Civitas.Id.Sweden.AspNetCore.csproj" />
  </ItemGroup>
</Project>
