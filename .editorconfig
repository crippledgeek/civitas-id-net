root = true

[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

# Folder = sub-namespace. Files in Civitas.Id.Sweden/Format/ use namespace
# Civitas.Id.Sweden.Format, etc. Matches NodaTime and Serilog convention.
# (Reverted from earlier "flat namespace" policy on 2026-05-08.)
dotnet_style_namespace_match_folder = true:error
dotnet_diagnostic.IDE0130.severity = error

# File-scoped namespaces (Microsoft Coding Conventions 2025)
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error

[*.{csproj,slnx,json}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Linked into every test project, each of which uses only some of the members and is inspected by itself.
[Civitas.Id.Sweden.Tests/Helpers/{CsvLoader,FixtureFiles,FixtureSpec,CheckDigits,LegalPersonNumber,LegalPersonNumbers,OfficialNumber,OfficialNumbers}.cs]
resharper_member_can_be_private_global_highlighting = none
resharper_unused_member_global_highlighting = none
resharper_not_accessed_positional_property_global_highlighting = none
