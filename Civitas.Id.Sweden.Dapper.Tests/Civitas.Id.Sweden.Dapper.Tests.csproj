<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      Same NoWarn set as Civitas.Id.Sweden.EntityFrameworkCore.Tests:
      CA1707/CA1515/CA1034/CA1052 — test-method naming + nested-classes idiom.
      CA2007 — TUnit async runtime has no SynchronizationContext.
      CA2000 — SQLite :memory: fixture intentionally keeps the connection open.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1034;CA1052;CA2007;CA2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.*" />
    <!--
      Override the transitive SQLitePCLRaw.lib.e_sqlite3 2.1.11 pulled by
      Microsoft.Data.Sqlite, which carries CVE-2025-6965 / GHSA-2m69-gcr7-jv3q
      (SQLite < 3.50.2 memory corruption) and fails restore via NU1903 under
      TreatWarningsAsErrors. The 2.x native package has no patch (deprecated,
      renamed to SourceGear.sqlite3 in 3.x); bundle_e_sqlite3 3.0.3 pulls
      SourceGear.sqlite3 (SQLite 3.50.4) instead, removing the vulnerable
      package from the graph. Remove this pin once Microsoft.Data.Sqlite
      references bundle_e_sqlite3 >= 3.0.x itself.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <ProjectReference Include="..\Civitas.Id.Sweden.Dapper\Civitas.Id.Sweden.Dapper.csproj" />
    <ProjectReference Include="..\Civitas.Id.Sweden.Fakers\Civitas.Id.Sweden.Fakers.csproj" />
  </ItemGroup>

</Project>
