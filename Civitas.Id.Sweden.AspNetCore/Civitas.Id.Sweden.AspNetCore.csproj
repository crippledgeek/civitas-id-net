<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- IL3058: shared-framework copy of Microsoft.AspNetCore.Http.Abstractions.dll
         is [IsTrimmable=true] but doesn't carry the newer opt-in [IsAotCompatible]
         metadata attribute. Suppress the noise warning that VerifyReferenceAotCompatibility
         would emit; the assembly is verified trim-safe by the ASP.NET Core team. -->
    <NoWarn>$(NoWarn);IL3058</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="JetBrains.Annotations.Sources" Version="2025.2.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <ProjectReference Include="..\Civitas.Id.Sweden.Json\Civitas.Id.Sweden.Json.csproj" />
    <ProjectReference Include="..\Civitas.Id.Sweden.DataAnnotations\Civitas.Id.Sweden.DataAnnotations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Civitas.Id.Sweden.AspNetCore.Tests" />
  </ItemGroup>

  <!--
    OpenAPI XmlComment source generator workaround.

    Microsoft.AspNetCore.OpenApi.targets ("GenerateAdditionalXmlFilesForOpenApi")
    adds the XML doc file of every ProjectReference as an AdditionalFile, so
    the bundled XmlCommentGenerator can emit per-member documentation. All
    Civitas.Id.Sweden* sibling packages embed JetBrains.Annotations.Sources
    as internal types, so the same XML doc keys
    ("T:JetBrains.Annotations.CanBeNullAttribute", etc.) appear in EVERY
    referenced XML file. The generator's Dictionary.Add fails with
    ArgumentException ("An item with the same key has already been added")
    on the first /openapi/v1.json request.

    Remove the sibling-project XML doc files before the source generator
    sees them. SwedishIdSchemaTransformer still applies format / pattern /
    example / description for the Civitas types via metadata.
  -->
  <Target Name="_StripCivitasXmlFromOpenApiAdditionalFiles"
          AfterTargets="GenerateAdditionalXmlFilesForOpenApi">
    <ItemGroup>
      <AdditionalFiles Remove="@(AdditionalFiles)"
                       Condition="$([System.String]::Copy('%(Filename)').StartsWith('Civitas.Id.Sweden'))" />
    </ItemGroup>
  </Target>

</Project>
