<Project>
  <!-- The official test numbers, for a test project outside Civitas.Id.Sweden.Tests: the sources that read
       them, and the pinned files they read. Linked, so there is one copy of each. A project lists any
       other helper it uses as an OfficialTestDataSource before the import. -->
  <ItemGroup>
    <OfficialTestDataSource Include="CsvLoader;FixtureFiles;FixtureSpec" />
    <OfficialTestDataSource Include="CheckDigits;LegalPersonNumber;LegalPersonNumbers" />
    <OfficialTestDataSource Include="OfficialNumber;OfficialNumbers;OfficialPersonnummer;OfficialSamordningsnummer" />
    <Compile Include="@(OfficialTestDataSource->'$(MSBuildThisFileDirectory)Helpers\%(Identity).cs')" Link="OfficialTestData\%(Filename)%(Extension)" />
    <OfficialTestDataFile Include="Testpersonnummer 1890-1899.csv;Testpersonnummer_2000-2009_official.csv" />
    <OfficialTestDataFile Include="Testsamordningsnummer_2019_official.csv;Testsamordningsnummer_2020_official.csv" />
    <OfficialTestDataFile Include="testorganisationsnummer_extended.csv" />
    <None Include="@(OfficialTestDataFile->'$(MSBuildThisFileDirectory)Fixtures\%(Identity)')" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Civitas.Id.Sweden.Tests.Helpers" />
  </ItemGroup>
</Project>
