<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      CA2007: ConfigureAwait — test projects run under TUnit's async infrastructure;
              there is no synchronization context where ConfigureAwait(false) would
              help. Suppressed project-wide to keep test bodies readable.
      CA2000: Dispose — SqliteFixture intentionally leaves the SqliteConnection
              open for the duration of the :memory: database's lifetime (see
              TestDbContext.cs, SqliteFixture remarks). Suppressed in the test
              project where this pattern is documented and intentional.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1034;CA1052;CA2007;CA2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!--
      Override the transitive SQLitePCLRaw.lib.e_sqlite3 2.1.11 pulled by
      Microsoft.EntityFrameworkCore.Sqlite, which carries CVE-2025-6965 /
      GHSA-2m69-gcr7-jv3q (SQLite < 3.50.2 memory corruption) and fails
      restore via NU1903 under TreatWarningsAsErrors. The 2.x native package
      has no patch (deprecated, renamed to SourceGear.sqlite3 in 3.x);
      bundle_e_sqlite3 3.0.3 pulls SourceGear.sqlite3 (SQLite 3.50.4) instead,
      removing the vulnerable package from the graph. Remove this pin once
      Microsoft.EntityFrameworkCore.Sqlite references bundle_e_sqlite3 >= 3.0.x.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <ProjectReference Include="..\Civitas.Id.Sweden.EntityFrameworkCore\Civitas.Id.Sweden.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\Civitas.Id.Sweden.Fakers\Civitas.Id.Sweden.Fakers.csproj" />
  </ItemGroup>

</Project>
